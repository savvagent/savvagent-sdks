{
  "name": "@savvagent/sdk",
  "version": "1.1.0",
  "description": "Savvagent TypeScript/JavaScript SDK for feature flags with AI-powered error detection",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/server/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "savvagent",
    "ai",
    "error-detection",
    "typescript"
  ],
  "author": "Rob Hicks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/typescript#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "prettier": "^3.7.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1"
  },
  "engines": {
    "node": ">=16"
  }
}
