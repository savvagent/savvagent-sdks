{
  "name": "@savvagent/astro",
  "version": "1.1.0",
  "description": "Astro integration for Savvagent feature flags",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./middleware": {
      "types": "./dist/middleware.d.mts",
      "import": "./dist/middleware.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/middleware.ts --format cjs,esm --dts --external astro --external virtual:@savvagent/astro/config",
    "dev": "tsup src/index.ts src/middleware.ts --format cjs,esm --dts --external astro --external virtual:@savvagent/astro/config --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "peerDependencies": {
    "astro": ">=4.14.0 <8"
  },
  "dependencies": {
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "astro": "^7.4.12",
    "eslint": "^8.57.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "astro",
    "integration",
    "middleware",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/astro#readme",
  "publishConfig": {
    "access": "public"
  }
}
