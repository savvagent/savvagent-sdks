{
  "name": "@savvagent/nextjs",
  "version": "1.1.0",
  "description": "Next.js SDK for Savvagent feature flags with App Router support",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.mts",
        "default": "./dist/middleware.mjs"
      },
      "require": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/server.ts src/middleware.ts --format cjs,esm --dts --external react --external next",
    "dev": "tsup src/index.ts src/client.ts src/server.ts src/middleware.ts --format cjs,esm --dts --external react --external next --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "next": ">=13.0.0 <17",
    "react": ">=18.0.0 <20"
  },
  "dependencies": {
    "@savvagent/react": "workspace:*",
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "nextjs",
    "next",
    "app-router",
    "server-components",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/nextjs#readme",
  "publishConfig": {
    "access": "public"
  }
}
