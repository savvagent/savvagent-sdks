{
  "name": "@savvagent/nextjs",
  "version": "1.0.0",
  "description": "Next.js SDK for Savvagent feature flags with App Router support",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/server.ts src/middleware.ts --format cjs,esm --dts --external react --external next",
    "dev": "tsup src/index.ts src/client.ts src/server.ts src/middleware.ts --format cjs,esm --dts --external react --external next --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@savvagent/react": "workspace:*",
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.27",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "nextjs",
    "next",
    "app-router",
    "server-components",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/savvagent-sdks",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/savvagent/savvagent-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/savvagent-sdks/tree/main/packages/nextjs#readme",
  "publishConfig": {
    "access": "public"
  }
}
