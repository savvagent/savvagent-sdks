{
  "name": "@savvagent/angular",
  "version": "1.0.0",
  "description": "Angular SDK for Savvagent feature flags",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0",
    "@angular/common": ">=14.0.0",
    "rxjs": ">=7.0.0"
  },
  "dependencies": {
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@angular/core": "^18.0.0",
    "@angular/common": "^18.0.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "angular",
    "service",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/savvagent-sdks",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/savvagent/savvagent-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/savvagent-sdks/tree/main/packages/angular#readme",
  "publishConfig": {
    "access": "public"
  }
}
