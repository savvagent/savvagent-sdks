{
  "name": "@savvagent/angular",
  "version": "1.1.0",
  "description": "Angular SDK for Savvagent feature flags",
  "author": "Savvagent",
  "license": "MIT",
  "main": "./dist/fesm2022/savvagent-angular.mjs",
  "module": "./dist/fesm2022/savvagent-angular.mjs",
  "types": "./dist/types/savvagent-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/savvagent-angular.d.ts",
      "esm2022": "./dist/fesm2022/savvagent-angular.mjs",
      "esm": "./dist/fesm2022/savvagent-angular.mjs",
      "default": "./dist/fesm2022/savvagent-angular.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "peerDependencies": {
    "@angular/common": ">=14.0.0 <23",
    "@angular/core": ">=14.0.0 <23",
    "rxjs": ">=7.0.0 <8"
  },
  "dependencies": {
    "@savvagent/sdk": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.3",
    "ng-packagr": "^22.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "dev": "ng-packagr -p ng-package.json --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "angular",
    "service",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/angular#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
