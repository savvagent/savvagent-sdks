{
  "name": "@savvagent/react",
  "version": "1.0.0",
  "description": "React SDK for Savvagent feature flags",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/react-hooks": "8.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.27",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "react",
    "hooks",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/savvagent-sdks",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/savvagent/savvagent-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/savvagent-sdks/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public"
  }
}
