{
  "name": "@savvagent/react",
  "version": "1.2.0",
  "description": "React SDK for Savvagent feature flags",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=16.8.0 <20"
  },
  "dependencies": {
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "react",
    "hooks",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/react#readme",
  "publishConfig": {
    "access": "public"
  }
}
