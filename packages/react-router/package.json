{
  "name": "@savvagent/react-router",
  "version": "0.0.0",
  "description": "React Router 8 SDK for Savvagent feature flags: server-side evaluation in loaders, actions and middleware, hydrated into the React provider",
  "author": "Savvagent",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external react-router",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --external react-router --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": ">=19.2.7 <20",
    "react-router": ">=8.5.1 <9"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@savvagent/react": "workspace:*",
    "@savvagent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jsdom": "^27.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.14"
  },
  "keywords": [
    "savvagent",
    "feature-flags",
    "react-router",
    "remix",
    "loaders",
    "actions",
    "middleware",
    "ssr",
    "feature-toggles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/savvagent/flags-sdks",
    "directory": "packages/react-router"
  },
  "bugs": {
    "url": "https://github.com/savvagent/flags-sdks/issues"
  },
  "homepage": "https://github.com/savvagent/flags-sdks/tree/master/packages/react-router#readme",
  "publishConfig": {
    "access": "public"
  }
}
