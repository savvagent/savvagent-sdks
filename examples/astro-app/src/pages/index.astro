---
/**
 * Feature demo, rendered on the server with `Astro.locals.savvagent`
 * (provided by the @savvagent/astro integration's middleware), then made
 * interactive in the browser by src/scripts/demo.ts with a FlagClient that
 * applies local overrides, user changes and realtime updates.
 */
import '../styles/global.css';
import { browserConfig } from '../savvagent.config.mjs';

const FLAGS = [
  { key: 'new-feature', name: 'New Feature', showConfig: true },
  { key: 'beta-feature', name: 'Beta Feature', showConfig: false },
  { key: 'enterprise-one', name: 'Enterprise One', showConfig: true },
] as const;

const DEFAULT_USER_ID = 'user-123';
const { savvagent } = Astro.locals;
// The demo trusts the `user_id` cookie (trustUserIdCookie in astro.config.mjs);
// fall back to the demo's default user.
const userId = savvagent.context.user_id ?? DEFAULT_USER_ID;
const flagContext = {
  user_id: userId,
  organization_id: 'org-456',
  attributes: { plan: 'premium', country: 'US' },
};

const results = await Promise.all(
  FLAGS.map(async (flag) => {
    const result = await savvagent.evaluate(flag.key, flagContext);
    return { ...flag, value: result.value, metadata: result.metadata };
  })
);
const newFeatureEnabled = results.find((r) => r.key === 'new-feature')?.value ?? false;

const clientConfig = browserConfig();
const initialState = {
  config: clientConfig,
  defaultUserId: DEFAULT_USER_ID,
  userId,
  context: { organization_id: flagContext.organization_id, attributes: flagContext.attributes },
  serverValues: Object.fromEntries(results.map((r) => [r.key, r.value])),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Savvagent Astro Example</title>
  </head>
  <body>
    <div class="container" id="demo" data-state={JSON.stringify(initialState)}>
      <h1>Savvagent Astro Example</h1>
      <p class="subtitle">SDK Developer Guide Best Practices Demo</p>

      {
        results.map((flag) => (
          <div class="feature-card" data-flag={flag.key}>
            <h2>
              {flag.name}
              <span class="override-badge-inline" hidden>
                LOCAL OVERRIDE
              </span>
            </h2>
            <p>
              Status:
              <span class={`status ${flag.value ? 'enabled' : 'disabled'}`}>
                {flag.value ? 'Enabled' : 'Disabled'}
              </span>
            </p>
            <p class="server-value" hidden>
              Server value: <span class="server-value-text" />
            </p>
            <p class="variation" hidden={!flag.metadata?.variation}>
              Variation: <span class="variation-text">{flag.metadata?.variation}</span>
            </p>
            {flag.showConfig && (
              <p class="config" hidden={!flag.metadata?.configuration}>
                Config:{' '}
                <code class="config-text">
                  {flag.metadata?.configuration ? JSON.stringify(flag.metadata.configuration) : ''}
                </code>
              </p>
            )}
          </div>
        ))
      }

      <div class="alert alert-success" hidden={!newFeatureEnabled}>
        <strong>New Feature Enabled!</strong>
        <p>This feature is enabled for you based on your user attributes.</p>
        <button type="button" class="btn" data-action="test-error">Test Error Tracking</button>
      </div>

      <div class="user-section">
        <h3>User Management</h3>
        <p>Current User ID: <code>{userId}</code></p>
        <button type="button" class="btn" data-action="random-user">Set Random User ID</button>
        <button type="button" class="btn btn-secondary" data-action="clear-user">Clear User ID</button>
      </div>
    </div>

    <div id="flag-panel-root">
      <button type="button" class="flag-panel-trigger" title="Open Flag Override Panel (Ctrl+Shift+F)">
        <span class="flag-icon">&#9873;</span>
      </button>
    </div>

    <script>
      import { startDemo } from '../scripts/demo';
      startDemo();
    </script>
  </body>
</html>
