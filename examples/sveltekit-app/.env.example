# Savvagent SDK Configuration
# Copy this file to .env and fill in your values

# SDK API Key (starts with sdk_)
VITE_SAVVAGENT_FLAGS_API_KEY=sdk_your_key_here

# Savvagent API URL
VITE_SAVVAGENT_FLAGS_API_URL=http://localhost:8080

# Server-side evaluation (src/hooks.server.ts); never sent to the browser
SAVVAGENT_FLAGS_API_KEY=your_server_key_here
# Optional; defaults to the SDK's Flags API
# SAVVAGENT_FLAGS_API_URL=http://localhost:8080
