{
  "name": "sveltekit-example",
  "version": "0.0.3",
  "private": true,
  "description": "Example SvelteKit app using Savvagent SDK",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
