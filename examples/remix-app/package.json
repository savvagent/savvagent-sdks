    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
